{% extends 'base.html.twig' %}

{% block title %}Contact - Temp Fast Mail{% endblock %}

{% block body %}
    <section class="section">
        <div class="container">
            <div class="columns is-centered">
                <div class="column is-8">
                    <div class="box">
                        <h1 class="title has-text-centered">Contact</h1>
                        <p>
                            Temporary Fast Mail is an open source project. The best way to reach me is through
                            <a href="https://github.com/kasteckis/tempfastmail" target="_blank" rel="noopener">GitHub</a>.
                        </p>

                        <h2 class="title is-4 mt-5">Feature requests</h2>
                        <p>
                            Have an idea that would make Temporary Fast Mail better? Create an issue on
                            <a href="https://github.com/kasteckis/tempfastmail/issues" target="_blank" rel="noopener">GitHub</a>
                            and describe what you would like to see.
                        </p>

                        <h2 class="title is-4 mt-5">Something does not work?</h2>
                        <p>
                            If something is broken or not working as expected, please create an issue on
                            <a href="https://github.com/kasteckis/tempfastmail/issues" target="_blank" rel="noopener">GitHub</a>.
                            Include what you did, what you expected to happen and what happened instead.
                        </p>

                        <h2 class="title is-4 mt-5">Get in touch</h2>
                        <p>
                            The best way to contact me is via
                            <a href="https://github.com/kasteckis/tempfastmail" target="_blank" rel="noopener">GitHub</a>.
                            Open an issue or start a discussion in the repository and I will get back to you.
                        </p>

                        <h2 class="title is-4 mt-5">Sponsor</h2>
                        <p>
                            If you find Temporary Fast Mail useful and want to support its development, you can sponsor me on
                            <a href="https://ko-fi.com/galgaldas" target="_blank" rel="noopener">Ko-fi</a>.
                        </p>

                        <div class="buttons is-centered mt-5">
                            <a class="button is-dark" href="https://github.com/kasteckis/tempfastmail" target="_blank" rel="noopener">
                                <strong>Visit project on GitHub</strong>
                            </a>
                            <a class="button is-primary is-light" href="https://ko-fi.com/galgaldas" target="_blank" rel="noopener">
                                <strong>Sponsor on Ko-fi</strong>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
