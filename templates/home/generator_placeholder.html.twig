<div class="columns is-centered">
    <div class="column is-8">
        <div class="columns is-mobile is-multiline">
            <div class="column is-12-mobile is-9-tablet">
                <label>
                    <input
                        class="input is-medium has-text-weight-semibold is-size-6-mobile"
                        type="text"
                        value="Loading ..."
                        aria-label="Your temporary email address"
                        readonly
                    >
                </label>
            </div>

            <div class="column is-12-mobile is-3-tablet">
                <button class="button is-primary is-medium is-fullwidth" type="button">
                    <span class="icon"><i class="fas fa-copy"></i></span>
                    <span>Copy</span>
                </button>
            </div>
        </div>
    </div>
</div>

<div class="buttons is-centered mb-5">
    <button class="button is-light" type="button">
        <span class="icon"><i class="fas fa-sync-alt"></i></span>
        <span>Regenerate Email</span>
    </button>
</div>
